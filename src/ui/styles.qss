QWidget#root {
    background: #f3f6fa;
    color: #17243a;
    font-family: "Segoe UI";
    font-size: 10pt;
}
QFrame#card {
    background: #ffffff;
    border: 1px solid #dfe6ee;
    border-radius: 14px;
}
QLabel[role="brand"] {
    background: #0c786f;
    color: #ffffff;
    border-radius: 12px;
    font-size: 22px;
    font-weight: 700;
}
QLabel[role="pageTitle"] {
    color: #14253d;
    font-size: 21px;
    font-weight: 700;
}
QLabel[role="sectionTitle"] {
    color: #152840;
    font-size: 13px;
    font-weight: 700;
}
QLabel[role="muted"], QLabel[role="legend"] {
    color: #718198;
}
QLabel[role="fieldLabel"], QLabel[role="columnHeader"] {
    color: #64758c;
    font-size: 9px;
    font-weight: 600;
}
QLabel[role="clock"] {
    background: #e7edf5;
    color: #20324a;
    border-radius: 8px;
    padding: 9px 13px;
    font-size: 13px;
    font-weight: 700;
    min-width: 58px;
}
QLabel[role="status"] {
    border-radius: 8px;
    padding: 9px 14px;
    font-size: 9px;
    font-weight: 700;
    min-width: 72px;
}
QLabel[role="status"][state="ready"] {
    background: #e7edf5;
    color: #4f6076;
}
QLabel[role="status"][state="running"] {
    background: #d9f4eb;
    color: #087d63;
}
QLabel[role="status"][state="paused"] {
    background: #fff1d9;
    color: #9a6512;
}
QLabel[role="status"][state="stopped"] {
    background: #fbe7e8;
    color: #aa444f;
}
QPushButton {
    background: #eef2f7;
    border: 1px solid #d7e0eb;
    border-radius: 8px;
    color: #253954;
    font-weight: 600;
    min-height: 34px;
    padding: 2px 16px;
}
QPushButton:hover {
    background: #e2eaf2;
}
QPushButton:focus {
    border: 2px solid #0c786f;
}
QPushButton:disabled {
    background: #f5f7fa;
    border-color: #e9edf2;
    color: #a9b4c1;
}
QPushButton[variant="primary"] {
    background: #0c786f;
    border-color: #0c786f;
    color: #ffffff;
}
QPushButton[variant="primary"]:hover {
    background: #08655d;
}
QPushButton[variant="primary"]:disabled {
    background: #b9d8d2;
    border-color: #b9d8d2;
    color: #ffffff;
}
QPushButton[variant="danger"] {
    color: #a4424d;
    background: #fff1f1;
    border-color: #f5d8dc;
}
QPushButton[variant="danger"]:disabled {
    color: #b9bfc7;
    background: #f5f7fa;
    border-color: #e9edf2;
}
QSpinBox, QComboBox, QPlainTextEdit {
    background: #f8fafc;
    border: 1px solid #d9e2ec;
    border-radius: 7px;
    color: #21334d;
    padding: 5px 8px;
    selection-background-color: #0c786f;
}
QSpinBox, QComboBox {
    min-height: 28px;
}
QSpinBox:focus, QComboBox:focus, QPlainTextEdit:focus {
    border-color: #0c786f;
}
QPlainTextEdit {
    font-family: "Consolas";
    font-size: 9pt;
}
QLabel[role="floorLabel"] {
    background: #eef3f8;
    border-radius: 7px;
    color: #445772;
    font-weight: 700;
    padding-left: 13px;
}
QLabel[role="carHere"] {
    background: #d9f4eb;
    border: 1px solid #a9dfd0;
    border-radius: 7px;
    color: #087d63;
    font-weight: 700;
}
QLabel[role="emptyShaft"] {
    background: #f8fafc;
    border: 1px solid #edf1f5;
    border-radius: 7px;
    color: #bdc9d5;
}
QScrollArea#sideScroll, QScrollArea#floorScroll, QFrame#floorGridFrame {
    background: transparent;
    border: none;
}
QScrollBar:vertical {
    background: #f2f5f8;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #cbd7e3;
    border-radius: 4px;
    min-height: 25px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
